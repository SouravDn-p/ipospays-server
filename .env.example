# App
PORT=7000
NODE_ENV=development
# Comma-separated browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Postgres. Host Nest uses localhost. Compose overrides this for the API container.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nest_template?schema=public

# Seed accounts. Passwords are hashed with argon2id. Re-running the seed updates these rows.
# SEED_USER_EMAIL=user@example.com
# SEED_USER_PASSWORD=
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=

# JWT. Required when NODE_ENV=production (dev-only fallbacks are refused).
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (optional until uploads are wired)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# iPOSpays — the payments module reads these. Keep sandbox until a sale, status check, and refund/void pass.
# Switch IPOSPAYS_ENV to production only after that. See docs/IPOSPAYS.md.
# IPOSPAYS_ENV=sandbox
# IPOSPAYS_API_KEY=
# IPOSPAYS_SECRET_KEY=
# IPOSPAYS_TPN=
# IPOSPAYS_TOKEN_EXPIRY_MINUTES=30
# IPOSPAYS_SCOPE=PaymentTokenization
