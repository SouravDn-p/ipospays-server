# App
PORT=7000
NODE_ENV=development
# Comma-separated browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Postgres. Host Nest uses localhost. Compose overrides this for the API container.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nest_template?schema=public

# JWT. Required when NODE_ENV=production (dev-only fallbacks are refused).
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (optional until uploads are wired)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# iPOSpays — fill sandbox values first. See docs/IPOSPAYS.md.
# The API does not call iPOSpays until the payment client is added.
# Switch IPOSPAYS_ENV to production only after sandbox sale, status, and refund/void pass.
# IPOSPAYS_ENV=sandbox
# IPOSPAYS_API_KEY=
# IPOSPAYS_SECRET_KEY=
# IPOSPAYS_TPN=
# IPOSPAYS_TOKEN_EXPIRY_MINUTES=30
